<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher mark: a padlock whose shackle is the accent colour and whose body is
  paper. Content is kept inside the 66dp safe circle (x 36..72, y 30..78) so no
  launcher mask clips it. Geometry is mirrored by LockMark in StartupSplash.kt —
  change one, change the other.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Shackle -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#6F93FF"
        android:strokeWidth="6.5"
        android:strokeLineCap="round"
        android:pathData="M42,52 V45.25 A12,12 0 0 1 66,45.25 V52" />

    <!-- Body -->
    <path
        android:fillColor="#EDF2FA"
        android:pathData="M43.5,52 h21 a7.5,7.5 0 0 1 7.5,7.5 v11 a7.5,7.5 0 0 1 -7.5,7.5 h-21 a7.5,7.5 0 0 1 -7.5,-7.5 v-11 a7.5,7.5 0 0 1 7.5,-7.5 z" />

    <!-- Keyhole -->
    <path
        android:fillColor="#6F93FF"
        android:pathData="M50.4,61 a3.6,3.6 0 1 0 7.2,0 a3.6,3.6 0 1 0 -7.2,0 z" />
    <path
        android:fillColor="#6F93FF"
        android:pathData="M52.4,61 h3.2 v7.4 a1.6,1.6 0 0 1 -3.2,0 z" />
</vector>
