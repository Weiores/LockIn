<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Night ink, warmed at the top so the plate has depth at large sizes but
         still reads as one flat tone inside a 48dp launcher tile. -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="18"
                android:startY="0"
                android:endX="90"
                android:endY="108">
                <item android:offset="0" android:color="#FF16233B" />
                <item android:offset="1" android:color="#FF080E18" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
